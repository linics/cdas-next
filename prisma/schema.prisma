generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum SchoolStatus {
  ACTIVE
  DISABLED
}

enum TeacherProvisioningStatus {
  PENDING
  IDENTITY_CREATED
  COMPLETED
  FAILED
}

enum DraftStatus {
  EDITING
  READY_FOR_PREVIEW
  SEALED
}

enum DraftRevisionSource {
  MANUAL
  AGENT
  RESTORE
}

enum ReleaseStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ActionIntentStatus {
  PREPARED
  CONFIRMED
  REJECTED
  EXECUTED
  EXPIRED
}

enum InvocationSource {
  UI
  AGENT
  SYSTEM
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  CONFLICTED
  FAILED
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FeedbackRevisionSource {
  MANUAL
  AI_ASSISTED
}

enum FeedbackNextStep {
  CONTINUE
  REVISE
}

enum FeedbackSupportLevel {
  FOUNDATION
  STANDARD
  CHALLENGE
}

enum AttachmentKind {
  IMAGE
  PDF
  WORD
}

enum AttachmentStatus {
  UPLOAD_PENDING
  SCAN_PENDING
  READY
  REJECTED
}

model School {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  code                  String                 @unique @db.VarChar(16)
  teacherInviteCodeHash String                 @map("teacher_invite_code_hash") @db.Char(64)
  status                SchoolStatus           @default(ACTIVE)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  users                 AppUser[]
  classrooms            Classroom[]
  teacherProvisionings  TeacherProvisioning[]

  @@map("schools")
}

model AppUser {
  id                    String                    @id @default(uuid()) @db.Uuid
  authSubject           String                    @unique @map("auth_subject")
  role                  UserRole
  displayName           String                    @map("display_name")
  rosterKey             String?                   @unique @map("roster_key") @db.VarChar(32)
  schoolId              String?                   @map("school_id") @db.Uuid
  staffNo               String?                   @map("staff_no") @db.VarChar(32)
  studentNo             String?                   @map("student_no") @db.VarChar(32)
  primaryDisciplineCode String?                   @map("primary_discipline_code") @db.VarChar(32)
  secondaryDisciplineCodes String[]               @default([]) @map("secondary_discipline_codes")
  accountStatus         AccountStatus             @default(ACTIVE) @map("account_status")
  legacyProfile         Boolean                   @default(false) @map("legacy_profile")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  school                School?                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classrooms            Classroom[]               @relation("ClassroomManager")
  memberships           ClassroomMembership[]     @relation("StudentMemberships")
  drafts                ActivityDraft[]           @relation("DraftOwner")
  releases              ActivityRelease[]         @relation("ReleasePublisher")
  actionIntents         ActionIntent[]            @relation("ActionIntentActor")
  actionDecisions       ActionIntent[]            @relation("ActionIntentDecider")
  idempotency           IdempotencyRecord[]
  auditEntries          ActionAudit[]
  agentRuns             AgentRun[]
  submissions           Submission[]              @relation("SubmissionStudent")
  releaseGroupMembers   ReleaseGroupMember[]
  submissionAttachments SubmissionAttachment[]    @relation("SubmissionAttachmentStudent")
  feedback                 TeacherFeedback[]           @relation("TeacherFeedbackTeacher")
  feedbackConfirmations    TeacherFeedbackRevision[]   @relation("TeacherFeedbackConfirmer")
  evaluations              TeacherEvaluation[]         @relation("TeacherEvaluationTeacher")
  evaluationConfirmations  TeacherEvaluationRevision[] @relation("TeacherEvaluationConfirmer")
  teacherProvisioning      TeacherProvisioning?
  localCredential          LocalCredential?
  authSessions             AuthSession[]

  @@unique([schoolId, staffNo])
  @@unique([schoolId, studentNo])
  @@index([schoolId, role, accountStatus])
  @@map("app_users")
}

model TeacherProvisioning {
  id                       String                     @id @default(uuid()) @db.Uuid
  schoolId                 String                     @map("school_id") @db.Uuid
  staffNo                  String                     @map("staff_no") @db.VarChar(32)
  displayName              String                     @map("display_name")
  primaryDisciplineCode    String                     @map("primary_discipline_code") @db.VarChar(32)
  secondaryDisciplineCodes String[]                   @default([]) @map("secondary_discipline_codes")
  identityIdentifier       String                     @unique @map("clerk_username") @db.VarChar(96)
  identitySubject          String?                    @unique @map("clerk_user_id")
  appUserId                String?                    @unique @map("app_user_id") @db.Uuid
  status                   TeacherProvisioningStatus  @default(PENDING)
  failureCode              String?                    @map("failure_code") @db.VarChar(120)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt              DateTime?                  @map("completed_at") @db.Timestamptz(3)
  school                   School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  appUser                  AppUser?                   @relation(fields: [appUserId], references: [id], onDelete: Restrict)

  @@unique([schoolId, staffNo])
  @@index([schoolId, status, createdAt])
  @@map("teacher_provisionings")
}

/**
 * 本地认证凭据与教学业务用户分离。密码只保存在 Argon2id 哈希中，永不保存明文。
 */
model LocalCredential {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  identifier          String    @unique @db.VarChar(96)
  passwordHash        String    @map("password_hash") @db.VarChar(256)
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  failedLoginCount    Int       @default(0) @map("failed_login_count")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([lockedUntil])
  @@map("local_credentials")
}

/** Server-side sessions; browsers receive only an opaque random token cookie. */
model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user       AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Classroom {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  managerId   String                @map("manager_id") @db.Uuid
  schoolId    String                @map("school_id") @db.Uuid
  version     Int                   @default(1)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  manager     AppUser               @relation("ClassroomManager", fields: [managerId], references: [id], onDelete: Restrict)
  school      School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  memberships ClassroomMembership[]
  releases    ActivityRelease[]

  @@index([managerId])
  @@index([schoolId, managerId])
  @@map("classrooms")
}

model ClassroomMembership {
  id          String    @id @default(uuid()) @db.Uuid
  classroomId String    @map("classroom_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student     AppUser   @relation("StudentMemberships", fields: [studentId], references: [id], onDelete: Restrict)

  @@index([classroomId, studentId])
  @@index([studentId, joinedAt, endedAt])
  @@map("classroom_memberships")
}

model ActivityDraft {
  id                   String                  @id @default(uuid()) @db.Uuid
  ownerId              String                  @map("owner_id") @db.Uuid
  status               DraftStatus             @default(EDITING)
  version              Int                     @default(1)
  schemaVersion        Int                     @default(1) @map("schema_version")
  taskBook             Json?                   @map("task_book")
  title                String
  summary              String
  learningObjectives   String[]                @default([]) @map("learning_objectives")
  taskInstructions     String                  @map("task_instructions")
  evidenceRequirements String[]                @default([]) @map("evidence_requirements")
  feedbackCriteria     String[]                @default([]) @map("feedback_criteria")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  sealedAt             DateTime?               @map("sealed_at") @db.Timestamptz(3)
  owner                AppUser                 @relation("DraftOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  revisions            ActivityDraftRevision[]
  release              ActivityRelease?

  @@index([ownerId, status, updatedAt])
  @@map("activity_drafts")
}

model ActivityDraftRevision {
  id                   String                    @id @default(uuid()) @db.Uuid
  draftId              String                    @map("draft_id") @db.Uuid
  version              Int
  source               DraftRevisionSource
  schemaVersion        Int                       @default(1) @map("schema_version")
  taskBook             Json?                     @map("task_book")
  title                String
  summary              String
  learningObjectives   String[]                  @default([]) @map("learning_objectives")
  taskInstructions     String                    @map("task_instructions")
  evidenceRequirements String[]                  @default([]) @map("evidence_requirements")
  feedbackCriteria     String[]                  @default([]) @map("feedback_criteria")
  agentRunId           String?                   @unique @map("agent_run_id") @db.Uuid
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  draft                ActivityDraft             @relation(fields: [draftId], references: [id], onDelete: Restrict)
  agentRun             AgentRun?                 @relation(fields: [agentRunId], references: [id], onDelete: Restrict)
  releaseSnapshots     ActivityReleaseSnapshot[]

  @@unique([draftId, version])
  @@map("activity_draft_revisions")
}

model ActivityRelease {
  id                  String                   @id @default(uuid()) @db.Uuid
  sourceDraftId       String                   @unique @map("source_draft_id") @db.Uuid
  publisherId         String                   @map("publisher_id") @db.Uuid
  classroomId         String                   @map("classroom_id") @db.Uuid
  actionIntentId      String                   @unique @map("action_intent_id") @db.Uuid
  closeActionIntentId String?                  @unique @map("close_action_intent_id") @db.Uuid
  executionVersion    Int                      @default(0) @map("execution_version")
  status              ReleaseStatus            @default(ACTIVE)
  publishedAt         DateTime                 @default(now()) @map("published_at") @db.Timestamptz(3)
  dueAt               DateTime?                @map("due_at") @db.Timestamptz(3)
  closedAt            DateTime?                @map("closed_at") @db.Timestamptz(3)
  archivedAt          DateTime?                @map("archived_at") @db.Timestamptz(3)
  sourceDraft         ActivityDraft            @relation(fields: [sourceDraftId], references: [id], onDelete: Restrict)
  publisher           AppUser                  @relation("ReleasePublisher", fields: [publisherId], references: [id], onDelete: Restrict)
  classroom           Classroom                @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  actionIntent        ActionIntent             @relation("PublishActionIntent", fields: [actionIntentId], references: [id], onDelete: Restrict)
  closeActionIntent   ActionIntent?            @relation("CloseActionIntent", fields: [closeActionIntentId], references: [id], onDelete: Restrict)
  snapshot            ActivityReleaseSnapshot?
  submissions         Submission[]
  groups              ReleaseGroup[]

  @@unique([id, sourceDraftId])
  @@index([classroomId, status, publishedAt])
  @@index([publisherId, publishedAt])
  @@map("activity_releases")
}

model ActivityReleaseSnapshot {
  releaseId          String                @id @map("release_id") @db.Uuid
  sourceDraftId      String                @map("source_draft_id") @db.Uuid
  sourceDraftVersion Int                   @map("source_draft_version")
  schemaVersion      Int                   @default(1) @map("schema_version")
  content            Json
  contentHash        String                @map("content_hash") @db.Char(64)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  release            ActivityRelease       @relation(fields: [releaseId, sourceDraftId], references: [id, sourceDraftId], onDelete: Restrict)
  sourceRevision     ActivityDraftRevision @relation(fields: [sourceDraftId, sourceDraftVersion], references: [draftId, version], onDelete: Restrict)

  @@unique([releaseId, sourceDraftId])
  @@index([sourceDraftId, sourceDraftVersion])
  @@map("activity_release_snapshots")
}

model Submission {
  id                   String                 @id @default(uuid()) @db.Uuid
  releaseId            String                 @map("release_id") @db.Uuid
  studentId            String?                @map("student_id") @db.Uuid
  groupId              String?                @map("group_id") @db.Uuid
  phaseIndex           Int                    @default(0) @map("phase_index")
  latestRevisionNumber Int                    @default(0) @map("latest_revision_number")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  release              ActivityRelease        @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  student              AppUser?               @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  group                ReleaseGroup?          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  workingCopy          SubmissionWorkingCopy?
  revisions            SubmissionRevision[]
  attachments          SubmissionAttachment[]

  @@unique([releaseId, studentId, phaseIndex])
  @@unique([releaseId, groupId, phaseIndex])
  @@index([studentId, createdAt])
  @@index([groupId, createdAt])
  @@map("submissions")
}

model ReleaseGroup {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releaseId   String               @map("release_id") @db.Uuid
  name        String               @db.VarChar(120)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  release     ActivityRelease      @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  members     ReleaseGroupMember[]
  submissions Submission[]

  @@unique([releaseId, name])
  @@index([releaseId])
  @@map("release_groups")
}

model ReleaseGroupMember {
  groupId   String       @map("group_id") @db.Uuid
  studentId String       @map("student_id") @db.Uuid
  roleLabel String?      @map("role_label") @db.VarChar(120)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  group     ReleaseGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  student   AppUser      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([groupId, studentId])
  @@index([studentId])
  @@map("release_group_members")
}

model SubmissionWorkingCopy {
  id                       String                            @id @default(uuid()) @db.Uuid
  submissionId             String                            @unique @map("submission_id") @db.Uuid
  baseRevisionNumber       Int                               @default(0) @map("base_revision_number")
  version                  Int                               @default(1)
  textEvidence             String                            @default("") @map("text_evidence") @db.Text
  completedEvidenceIndexes Int[]                             @default([]) @map("completed_evidence_indexes")
  createdAt                DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)
  submission               Submission                        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  attachments              SubmissionWorkingCopyAttachment[]

  @@map("submission_working_copies")
}

model SubmissionRevision {
  id                       String                         @id @default(uuid()) @db.Uuid
  submissionId             String                         @map("submission_id") @db.Uuid
  revisionNumber           Int                            @map("revision_number")
  baseRevisionNumber       Int                            @map("base_revision_number")
  sourceWorkingCopyId      String                         @unique @map("source_working_copy_id") @db.Uuid
  sourceWorkingVersion     Int                            @map("source_working_version")
  textEvidence             String                         @map("text_evidence") @db.Text
  completedEvidenceIndexes Int[]                          @default([]) @map("completed_evidence_indexes")
  isLate                   Boolean                        @map("is_late")
  submittedAt              DateTime                       @map("submitted_at") @db.Timestamptz(3)
  submission               Submission                     @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  feedback                 TeacherFeedback?
  evaluation               TeacherEvaluation?
  attachments              SubmissionRevisionAttachment[]

  @@unique([submissionId, revisionNumber])
  @@map("submission_revisions")
}

model SubmissionAttachment {
  id               String                            @id @default(uuid()) @db.Uuid
  submissionId     String                            @map("submission_id") @db.Uuid
  studentId        String                            @map("student_id") @db.Uuid
  kind             AttachmentKind
  originalFilename String                            @map("original_filename") @db.VarChar(255)
  mediaType        String                            @map("media_type") @db.VarChar(127)
  byteSize         Int                               @map("byte_size")
  storageKey       String                            @unique @map("storage_key") @db.VarChar(512)
  status           AttachmentStatus                  @default(UPLOAD_PENDING)
  createdAt        DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedAt       DateTime?                         @map("uploaded_at") @db.Timestamptz(3)
  scannedAt        DateTime?                         @map("scanned_at") @db.Timestamptz(3)
  submission       Submission                        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  student          AppUser                           @relation("SubmissionAttachmentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  workingCopies    SubmissionWorkingCopyAttachment[]
  revisions        SubmissionRevisionAttachment[]

  @@index([submissionId, status, createdAt])
  @@index([studentId, createdAt])
  @@map("submission_attachments")
}

model SubmissionWorkingCopyAttachment {
  workingCopyId String                @map("working_copy_id") @db.Uuid
  attachmentId  String                @map("attachment_id") @db.Uuid
  position      Int
  addedAt       DateTime              @default(now()) @map("added_at") @db.Timestamptz(3)
  workingCopy   SubmissionWorkingCopy @relation(fields: [workingCopyId], references: [id], onDelete: Restrict)
  attachment    SubmissionAttachment  @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@id([workingCopyId, attachmentId])
  @@unique([workingCopyId, position], map: "submission_working_copy_attachments_position_key")
  @@index([attachmentId])
  @@map("submission_working_copy_attachments")
}

model SubmissionRevisionAttachment {
  submissionRevisionId String               @map("submission_revision_id") @db.Uuid
  attachmentId         String               @map("attachment_id") @db.Uuid
  position             Int
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  submissionRevision   SubmissionRevision   @relation(fields: [submissionRevisionId], references: [id], onDelete: Restrict)
  attachment           SubmissionAttachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@id([submissionRevisionId, attachmentId])
  @@unique([submissionRevisionId, position], map: "submission_revision_attachments_position_key")
  @@index([attachmentId])
  @@map("submission_revision_attachments")
}

model TeacherFeedback {
  id                   String                    @id @default(uuid()) @db.Uuid
  submissionRevisionId String                    @unique @map("submission_revision_id") @db.Uuid
  teacherId            String                    @map("teacher_id") @db.Uuid
  version              Int
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  submissionRevision   SubmissionRevision        @relation(fields: [submissionRevisionId], references: [id], onDelete: Restrict)
  teacher              AppUser                   @relation("TeacherFeedbackTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  revisions            TeacherFeedbackRevision[]

  @@index([teacherId, updatedAt])
  @@map("teacher_feedback")
}

model TeacherFeedbackRevision {
  id                String                 @id @default(uuid()) @db.Uuid
  teacherFeedbackId String                 @map("teacher_feedback_id") @db.Uuid
  version           Int
  body              String                 @db.Text
  bodyHash          String                 @map("body_hash") @db.Char(64)
  nextStep          FeedbackNextStep?      @map("next_step")
  supportLevel      FeedbackSupportLevel?  @map("support_level")
  source            FeedbackRevisionSource
  confirmedById     String                 @map("confirmed_by_id") @db.Uuid
  actionIntentId    String                 @unique @map("action_intent_id") @db.Uuid
  agentRunId        String?                @map("agent_run_id") @db.Uuid
  confirmedAt       DateTime               @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  feedback          TeacherFeedback        @relation(fields: [teacherFeedbackId], references: [id], onDelete: Restrict)
  confirmedBy       AppUser                @relation("TeacherFeedbackConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  actionIntent      ActionIntent           @relation(fields: [actionIntentId], references: [id], onDelete: Restrict)
  agentRun          AgentRun?              @relation(fields: [agentRunId], references: [id], onDelete: Restrict)

  @@unique([teacherFeedbackId, version])
  @@index([agentRunId])
  @@map("teacher_feedback_revisions")
}

model TeacherEvaluation {
  id                   String                      @id @default(uuid()) @db.Uuid
  submissionRevisionId String                      @unique @map("submission_revision_id") @db.Uuid
  teacherId            String                      @map("teacher_id") @db.Uuid
  version              Int
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  submissionRevision   SubmissionRevision          @relation(fields: [submissionRevisionId], references: [id], onDelete: Restrict)
  teacher              AppUser                     @relation("TeacherEvaluationTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  revisions            TeacherEvaluationRevision[]

  @@index([teacherId, updatedAt])
  @@map("teacher_evaluations")
}

model TeacherEvaluationRevision {
  id                  String                 @id @default(uuid()) @db.Uuid
  teacherEvaluationId String                 @map("teacher_evaluation_id") @db.Uuid
  version             Int
  summary             String                 @db.Text
  summaryHash         String                 @map("summary_hash") @db.Char(64)
  outcomes            Json
  source              FeedbackRevisionSource
  confirmedById       String                 @map("confirmed_by_id") @db.Uuid
  actionIntentId      String                 @unique @map("action_intent_id") @db.Uuid
  agentRunId          String?                @map("agent_run_id") @db.Uuid
  confirmedAt         DateTime               @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  evaluation          TeacherEvaluation      @relation(fields: [teacherEvaluationId], references: [id], onDelete: Restrict)
  confirmedBy         AppUser                @relation("TeacherEvaluationConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  actionIntent        ActionIntent           @relation(fields: [actionIntentId], references: [id], onDelete: Restrict)
  agentRun            AgentRun?              @relation(fields: [agentRunId], references: [id], onDelete: Restrict)

  @@unique([teacherEvaluationId, version])
  @@index([agentRunId])
  @@map("teacher_evaluation_revisions")
}

model AgentRun {
  id                String                    @id @default(uuid()) @db.Uuid
  actorId           String                    @map("actor_id") @db.Uuid
  status            AgentRunStatus            @default(RUNNING)
  model             String
  startedAt         DateTime                  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?                 @map("completed_at") @db.Timestamptz(3)
  failureCode       String?                   @map("failure_code")
  actor             AppUser                   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  draftRevision       ActivityDraftRevision?
  intents             ActionIntent[]
  auditEntries        ActionAudit[]
  feedbackRevisions   TeacherFeedbackRevision[]
  evaluationRevisions TeacherEvaluationRevision[]

  @@index([actorId, startedAt])
  @@map("agent_runs")
}

model ActionIntent {
  id               String                   @id @default(uuid()) @db.Uuid
  actorId          String                   @map("actor_id") @db.Uuid
  decidedById      String?                  @map("decided_by_id") @db.Uuid
  agentRunId       String?                  @map("agent_run_id") @db.Uuid
  actionName       String                   @map("action_name")
  payload          Json
  payloadHash      String                   @map("payload_hash") @db.Char(64)
  targetType       String                   @map("target_type")
  targetId         String                   @map("target_id") @db.Uuid
  expectedVersion  Int?                     @map("expected_version")
  status           ActionIntentStatus       @default(PREPARED)
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  decidedAt        DateTime?                @map("decided_at") @db.Timestamptz(3)
  executedAt       DateTime?                @map("executed_at") @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  actor            AppUser                  @relation("ActionIntentActor", fields: [actorId], references: [id], onDelete: Restrict)
  decidedBy        AppUser?                 @relation("ActionIntentDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  agentRun         AgentRun?                @relation(fields: [agentRunId], references: [id], onDelete: Restrict)
  auditEntries        ActionAudit[]
  feedbackRevision    TeacherFeedbackRevision?
  evaluationRevision  TeacherEvaluationRevision?
  publishRelease      ActivityRelease?         @relation("PublishActionIntent")
  closedRelease    ActivityRelease?         @relation("CloseActionIntent")

  @@index([actorId, status, expiresAt])
  @@index([targetType, targetId])
  @@map("action_intents")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  commandName    String   @map("command_name")
  idempotencyKey String   @map("idempotency_key")
  requestHash    String   @map("request_hash") @db.Char(64)
  response       Json
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          AppUser  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, commandName, idempotencyKey])
  @@index([resourceType, resourceId])
  @@map("idempotency_records")
}

model ActionAudit {
  id               String           @id @default(uuid()) @db.Uuid
  actorId          String           @map("actor_id") @db.Uuid
  agentRunId       String?          @map("agent_run_id") @db.Uuid
  actionIntentId   String?          @map("action_intent_id") @db.Uuid
  source           InvocationSource
  actionName       String           @map("action_name")
  targetType       String           @map("target_type")
  targetId         String           @map("target_id") @db.Uuid
  requestHash      String           @map("request_hash") @db.Char(64)
  idempotencyKey   String?          @map("idempotency_key")
  outcome          AuditOutcome
  errorCode        String?          @map("error_code")
  beforeVersion    Int?             @map("before_version")
  afterVersion     Int?             @map("after_version")
  resultResourceId String?          @map("result_resource_id") @db.Uuid
  traceId          String           @map("trace_id")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  actor            AppUser          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  agentRun         AgentRun?        @relation(fields: [agentRunId], references: [id], onDelete: Restrict)
  actionIntent     ActionIntent?    @relation(fields: [actionIntentId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([traceId])
  @@map("action_audits")
}
