# PostgreSQL. Use a local database while developing; use a pooled URL at runtime when deploying to Neon.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cdas_next
# DIRECT_URL is optional locally. Hosted PostgreSQL uses it for migrations.
DIRECT_URL=
# Disposable database used only by SQL invariants and integration tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/cdas_next_test
# Disposable database used only by the real-browser closed-loop gate.
E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/cdas_next_e2e

# Authentication is local to PostgreSQL. Create the single platform admin with
# `pnpm bootstrap:admin`; provision teacher/student accounts through the product
# workflows. Never place account passwords in this file.

# The ordinary teacher/student workflow must work when this is disabled.
AI_PROVIDER_DISABLED=1
# Direct DeepSeek API. Set AI_PROVIDER_DISABLED=0 only after all three values exist.
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-v4-flash
# Isolated image-description subcall used only by teacher review suggestions.
AI_ATTACHMENT_VISION_MODEL=deepseek-v4-flash-vision-exp
# Generate at least 32 random bytes, for example: openssl rand -base64 32
AI_TOOL_APPROVAL_SECRET=
# Keep empty by default. Pass the documented phrase only for one intentional,
# synthetic-data provider smoke that may consume paid tokens.
E2E_REAL_MODEL_ACK=

# Attachment storage. Set ATTACHMENT_STORAGE_ENABLED=1 and exactly one backend.
#
# Self-hosted: a directory on this machine. The browser uploads through the app,
# because there is nothing to presign against. Keep it outside the release
# directory so a deploy's release rotation never touches student files.
ATTACHMENT_STORAGE_DIR=
#
# Vercel Private Blob: the browser writes to Blob directly. Vercel supplies
# short-lived OIDC automatically to connected deployments; do not create
# BLOB_READ_WRITE_TOKEN.
ATTACHMENT_STORAGE_ENABLED=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Protected remote staging Go/No-Go. Do not put any of these values in .env,
# commit history, or a local E2E configuration. The GitHub Environment supplies
# the secrets and records the human attestations; an incomplete configuration
# produces a sanitized NO_GO artifact and never connects to the database.
STAGING_RUN_MARKER=
STAGING_DATA_ACK=
STAGING_BASE_URL=
STAGING_VERCEL_PROJECT_NAME=
STAGING_DATABASE_NAME=
STAGING_TEST_PRIMARY_SCHOOL_CODE=
STAGING_TEST_SECONDARY_SCHOOL_CODE=
STAGING_TEST_TEACHER_STAFF_NO=
STAGING_TEST_STUDENT_NO=
STAGING_TEST_OTHER_STUDENT_NO=
STAGING_TEST_OTHER_TEACHER_STAFF_NO=
STAGING_TEST_DISABLED_ACCOUNT_STUDENT_NO=
STAGING_TEST_DISABLED_SCHOOL_CODE=
STAGING_TEST_DISABLED_SCHOOL_TEACHER_STAFF_NO=
STAGING_AI_ACK=
STAGING_SYNTHETIC_ONLY_ATTESTED=
STAGING_LOCAL_AUTH_ATTESTED=
STAGING_DATABASE_ISOLATION_ATTESTED=
STAGING_HOSTING_ACCESS_ATTESTED=
STAGING_ROLLBACK_OWNER_ATTESTED=
STAGING_RETENTION_ATTESTED=
CDAS_DEPLOYMENT_ID=
STAGING_HEALTH_PROOF_SECRET=

# Staging/e2e passwords are generated per run or stored only as protected
# GitHub Environment secrets (`STAGING_TEST_*_PASSWORD`). They do not belong in
# `.env`, `.env.local`, command lines, logs, screenshots, or artifacts.
