[Unit]
Description=CDAS Next (self-hosted)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/cdas-next/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
# Do not set HOSTNAME: Next.js and Node reserve it for the machine hostname.
Environment=NODE_OPTIONS=--max-old-space-size=768
EnvironmentFile=-/opt/cdas-next/shared/.env
ExecStart=/opt/cdas-next/node/bin/node /opt/cdas-next/current/server.js
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=20
KillSignal=SIGTERM
OOMPolicy=stop
# Whole VPS is dedicated to CDAS Next + PostgreSQL (score-my-lover removed).
MemoryHigh=1100M
MemoryMax=1400M
TasksMax=128
LimitNOFILE=8192
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cdas-next
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
