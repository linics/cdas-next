# Copy to /opt/cdas-next/shared/.env on the VPS (mode 0600). Never commit real values.

DATABASE_URL=postgresql://cdas:CHANGE_ME@127.0.0.1:5432/cdas_next
DIRECT_URL=postgresql://cdas:CHANGE_ME@127.0.0.1:5432/cdas_next

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

AI_PROVIDER_DISABLED=1
# DEEPSEEK_API_KEY=
# AI_MODEL=deepseek-v4-flash
# AI_TOOL_APPROVAL_SECRET=

ATTACHMENT_STORAGE_ENABLED=

# Optional: only if you want /api/health to return configurationProof
# STAGING_HEALTH_PROOF_SECRET=
